{%- comment -%}
  Vigour Massage Studio - Official Brand Logo
  Usage: {% render 'vigour-logo', color: '#243F3A', class: 'custom-class', show_text: true %}
{%- endcomment -%}

{%- assign logo_color = color | default: 'currentColor' -%}
{%- assign show_text = show_text | default: true -%}
{%- assign logo_class = class | default: 'vm-brand-logo' -%}

<div class="{{ logo_class }}" style="display: inline-flex; align-items: center; gap: 14px; text-decoration: none; color: {{ logo_color }};">
  <!-- Monogram Pill Mark -->
  <svg class="vm-logo-mark" width="40" height="40" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="VM Monogram">
    <!-- Outer Pill / Oval Outline -->
    <rect x="2" y="2" width="40" height="40" rx="20" stroke="currentColor" stroke-width="2.2"/>
    <!-- Stylized V & M intertwine -->
    <path d="M12 14L18 30L22 20L26 30L32 14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>

  {%- if show_text -%}
    <!-- Brand Typography -->
    <div class="vm-logo-text" style="display: flex; flex-direction: column; line-height: 1;">
      <span class="vm-logo-title" style="font-family: 'Montserrat', sans-serif; font-size: 1.15rem; font-weight: 800; letter-spacing: 0.22em; text-transform: uppercase;">
        VIGOUR
      </span>
      <span class="vm-logo-subtitle" style="font-family: 'Montserrat', sans-serif; font-size: 0.62rem; font-weight: 600; letter-spacing: 0.28em; text-transform: uppercase; opacity: 0.85; margin-top: 4px;">
        MASSAGE STUDIO
      </span>
    </div>
  {%- endif -%}
</div>
