{%- comment -%}
  Vigour Massage Studio logo: an arch with a spine inside, plus the wordmark.
  Styles live in vigour-tokens.css (.vm-logo).

  Usage:
    {% render 'vigour-logo' %}                    light background
    {% render 'vigour-logo', on_dark: true %}     dark background (footer)
    {% render 'vigour-logo', show_text: false %}  mark only
{%- endcomment -%}

<span class="vm-logo{% if on_dark %} vm-logo--on-dark{% endif %}">
  <svg class="vm-logo-mark" viewBox="0 0 30 44" aria-hidden="true" focusable="false">
    <rect x="1.2" y="1.2" width="27.6" height="41.6" rx="13.8" fill="none" stroke="currentColor" stroke-width="1.2"/>
    <path d="M8.6 10.5V31M22.4 9.5V34M16 34.5 22.4 9.5" fill="none" stroke="currentColor" stroke-width=".9"/>
    <path d="M8.6 10.5 16 34.5" fill="none" stroke="currentColor" stroke-width="3.4"/>
  </svg>
  {%- unless show_text == false -%}
    <span class="vm-logo-text">
      <span class="vm-logo-name">VIGOUR</span>
      <span class="vm-logo-sub">massage studio</span>
    </span>
  {%- endunless -%}
</span>
