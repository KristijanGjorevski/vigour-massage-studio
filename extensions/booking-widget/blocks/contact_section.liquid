{{ 'vigour-tokens.css' | asset_url | stylesheet_tag }}
{{ 'contact-section.css' | asset_url | stylesheet_tag }}

<section class="vm-block-wrapper vm-contact-section" 
         id="vm-contact-{{ block.id }}" 
         data-block-id="{{ block.id }}">
  <div class="vm-container">
    
    <div class="vm-contact-header">
      <div class="vm-eyebrow">
        {% render 'vigour-icons', name: 'map-pin' %}
        <span>{{ block.settings.eyebrow | default: 'ЛОКАЦИЈА И КОНТАКТ' }}</span>
      </div>
      <h2 class="vm-heading-lg vm-contact-title">
        {{ block.settings.heading | default: 'Посетете не или закажете веднаш' }}
      </h2>
      <p class="vm-contact-subtitle">
        {{ block.settings.subheading | default: 'Најбрзиот начин за прашања или директна комуникација со терапевтот е преку Viber или Instagram порака.' }}
      </p>
    </div>

    <div class="vm-contact-grid">
      
      <div class="vm-contact-info-col">
        
        <div class="vm-viber-card">
          <div class="vm-viber-top">
            <div class="vm-viber-icon-wrap">
              {% render 'vigour-icons', name: 'viber' %}
            </div>
            <div>
              <div class="vm-viber-title">Директен разговор на Viber</div>
              <div class="vm-viber-sub">Инстант одговор за слободни термини и прашања</div>
            </div>
          </div>
          <a href="viber://chat?number=38975304171" class="vm-viber-btn">
            {% render 'vigour-icons', name: 'viber' %}
            <span>Пиши на Viber (+389 75 304 171)</span>
          </a>
        </div>

        <div class="vm-channels-grid">
          <a href="tel:+38975304171" class="vm-channel-box">
            <div class="vm-channel-icon-title">
              <div class="vm-channel-icon">
                {% render 'vigour-icons', name: 'phone' %}
              </div>
              <span class="vm-channel-name">Телефонски Повик</span>
            </div>
            <span class="vm-channel-val">+389 75 304 171</span>
          </a>

          <a href="https://instagram.com/vigour.massagestudio" target="_blank" rel="noopener noreferrer" class="vm-channel-box">
            <div class="vm-channel-icon-title">
              <div class="vm-channel-icon">
                {% render 'vigour-icons', name: 'instagram' %}
              </div>
              <span class="vm-channel-name">Instagram DM</span>
            </div>
            <span class="vm-channel-val">@vigour.massagestudio</span>
          </a>
        </div>

        <div class="vm-hours-card">
          <div class="vm-hours-title">
            {% render 'vigour-icons', name: 'clock' %}
            <span>Работно Време на Студиото</span>
          </div>
          <div class="vm-hours-list">
            <div class="vm-hours-row highlight">
              <span>Понеделник - Петок:</span>
              <span>10:00 - 20:00</span>
            </div>
            <div class="vm-hours-row">
              <span>Сабота:</span>
              <span>10:00 - 18:00</span>
            </div>
            <div class="vm-hours-row">
              <span>Недела:</span>
              <span>По претходен договор</span>
            </div>
          </div>
        </div>

      </div>

      <div class="vm-contact-map-col">
        <div class="vm-map-wrapper">
          <iframe 
            src="{{ block.settings.map_embed_url | default: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d47458.74917539669!2d21.385564883908867!3d41.996466795088285!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x135415a58c9fca51%3A0x60c7c32f7a42220!2sSkopje%2C%20North%20Macedonia!5e0!3m2!1sen!2smk!4v1700000000000!5m2!1sen!2smk' }}" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Vigour Massage Studio Локација">
          </iframe>
        </div>
        <div class="vm-map-meta">
          <div class="vm-map-address">
            {% render 'vigour-icons', name: 'map-pin' %}
            <span>{{ block.settings.address | default: 'Скопје, Македонија' }}</span>
          </div>
          <a href="https://maps.google.com/?q=Skopje+Macedonia" target="_blank" rel="noopener noreferrer" class="vm-map-directions-btn">
            Отвори Навигација
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "VM Contact",
  "target": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "subheading", "label": "Subheading"},
    {"type": "text", "id": "address", "label": "Address"},
    {"type": "textarea", "id": "map_embed_url", "label": "Google Maps Embed URL"}
  ]
}
{% endschema %}
