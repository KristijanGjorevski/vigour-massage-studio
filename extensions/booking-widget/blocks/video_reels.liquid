{{ 'vigour-tokens.css' | asset_url | stylesheet_tag }}
{{ 'video-reels.css' | asset_url | stylesheet_tag }}

<section class="vm-block-wrapper vm-reels-section" 
         id="vm-reels-{{ block.id }}" 
         data-block-id="{{ block.id }}">
  <div class="vm-container">
    
    <div class="vm-reels-header">
      <div class="vm-eyebrow">
        {% render 'vigour-icons', name: 'play' %}
        <span>{% render 'vigour-text', value: block.settings.eyebrow, key: 'reels.eyebrow' %}</span>
      </div>
      <h2 class="vm-heading-lg vm-reels-title">
        {% render 'vigour-text', value: block.settings.heading, key: 'reels.heading' %}
      </h2>
      <p class="vm-reels-subtitle">
        {% render 'vigour-text', value: block.settings.subheading, key: 'reels.subheading' %}
      </p>
    </div>

    <div class="vm-reels-grid">
      
      <div class="vm-reel-card" data-video-id="dQw4w9WgXcQ">
        <div class="vm-reel-bg-gradient"></div>
        <div class="vm-reel-play-icon">
          {% render 'vigour-icons', name: 'play' %}
        </div>
        <div class="vm-reel-content">
          <h3 class="vm-reel-title">{{ 'reels.reel_1' | t }}</h3>
          <span class="vm-reel-sub">0:45 · Vigour</span>
        </div>
      </div>

      <div class="vm-reel-card" data-video-id="dQw4w9WgXcQ">
        <div class="vm-reel-bg-gradient"></div>
        <div class="vm-reel-play-icon">
          {% render 'vigour-icons', name: 'play' %}
        </div>
        <div class="vm-reel-content">
          <h3 class="vm-reel-title">{{ 'reels.reel_2' | t }}</h3>
          <span class="vm-reel-sub">0:38 · Vigour</span>
        </div>
      </div>

      <div class="vm-reel-card" data-video-id="dQw4w9WgXcQ">
        <div class="vm-reel-bg-gradient"></div>
        <div class="vm-reel-play-icon">
          {% render 'vigour-icons', name: 'play' %}
        </div>
        <div class="vm-reel-content">
          <h3 class="vm-reel-title">{{ 'reels.reel_3' | t }}</h3>
          <span class="vm-reel-sub">2:05 · Vigour</span>
        </div>
      </div>

      <div class="vm-reel-card" data-video-id="dQw4w9WgXcQ">
        <div class="vm-reel-bg-gradient"></div>
        <div class="vm-reel-play-icon">
          {% render 'vigour-icons', name: 'play' %}
        </div>
        <div class="vm-reel-content">
          <h3 class="vm-reel-title">{{ 'reels.reel_4' | t }}</h3>
          <span class="vm-reel-sub">1:10 · Vigour</span>
        </div>
      </div>

    </div>

    <div class="vm-video-modal" aria-hidden="true">
      <div class="vm-video-modal-content">
        <button type="button" class="vm-video-modal-close" aria-label="{{ 'common.close_video' | t | escape }}">✕</button>
        <iframe class="vm-video-iframe" src="" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>

  </div>
</section>

<script src="{{ 'video-reels.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "VM Video Reels",
  "target": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "subheading", "label": "Subheading"}
  ]
}
{% endschema %}
