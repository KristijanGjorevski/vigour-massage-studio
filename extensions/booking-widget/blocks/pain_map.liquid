{{ 'vigour-tokens.css' | asset_url | stylesheet_tag }}
{{ 'pain-map.css' | asset_url | stylesheet_tag }}

<section class="vm-block-wrapper vm-painmap-section" 
         id="vm-painmap" 
         data-block-id="{{ block.id }}">
  <div class="vm-container">
    
    <div class="vm-painmap-header">
      <div class="vm-eyebrow">
        {% render 'vigour-icons', name: 'spark' %}
        <span>{% render 'vigour-text', value: block.settings.eyebrow, key: 'pain_map.eyebrow' %}</span>
      </div>
      <h2 class="vm-heading-lg vm-painmap-title">
        {% render 'vigour-text', value: block.settings.heading, key: 'pain_map.heading' %}
      </h2>
      <p class="vm-painmap-subtitle">
        {% render 'vigour-text', value: block.settings.subheading, key: 'pain_map.subheading' %}
      </p>
    </div>

    {%- comment -%} Zone texts are too long for a locale file (15 KB limit): one file per language in assets/ {%- endcomment -%}
    {%- assign zones_file = 'pain-zones-en.json' -%}
    {%- if request.locale.iso_code == 'mk' -%}{%- assign zones_file = 'pain-zones-mk.json' -%}{%- endif -%}
    {%- assign zone_keys = 'neck,shoulders,upper_back,lower_back,hips,legs,feet' | split: ',' -%}

    <div class="vm-painmap-pills-bar">
      {%- for key in zone_keys -%}
        {%- assign pill_key = 'pain_zones.' | append: key | append: '.pill' -%}
        <button type="button" class="vm-zone-pill-btn{% if forloop.first %} active{% endif %}" data-zone="{{ key }}">{{ pill_key | t }}</button>
      {%- endfor -%}
    </div>

    <div class="vm-painmap-grid">
      
      <div class="vm-bodymap-container" data-svg-url="{{ 'body-map.svg' | asset_url }}" data-svg-label="{{ 'pain_map.body_label' | t | escape }}" data-zones-url="{{ zones_file | asset_url }}">
        <div class="vm-bodymap-instructions">
          {% render 'vigour-icons', name: 'spark' %}
          <span>{{ 'pain_map.instructions' | t }}</span>
        </div>
      </div>

      <div class="vm-zone-panel">
        
        <div class="vm-zone-panel-header">
          <div class="vm-zone-tag">
            {% render 'vigour-icons', name: 'shield' %}
            <span class="vm-zone-tag-text"></span>
          </div>
          <h3 class="vm-zone-name"></h3>
        </div>

        <div class="vm-zone-causes">
          <strong>{{ 'pain_map.causes_label' | t }}</strong>
          <span class="vm-zone-causes-text">
            
          </span>
        </div>

        <div class="vm-rec-card">
          <div class="vm-rec-card-eyebrow">
            {% render 'vigour-icons', name: 'spark' %}
            <span>{{ 'pain_map.rec_eyebrow' | t }}</span>
          </div>
          <h4 class="vm-rec-card-title"></h4>
          <p class="vm-rec-card-desc">
            
          </p>

          <div class="vm-rec-card-footer">
            <div class="vm-rec-price-wrap">
              <span class="vm-rec-price-badge vm-rec-price-text"></span>
              <small class="vm-rec-duration-text"></small>
            </div>

            <a href="{{ block.settings.booking_link | default: '#najdo-booking-container' }}" 
               class="vm-btn-primary vm-rec-book-btn"
               data-service-name="Релакс масажа - Грб">
              <span>{{ 'pain_map.rec_button' | t }}</span>
              {% render 'vigour-icons', name: 'chevron-right' %}
            </a>
          </div>
        </div>

        <div class="vm-exercise-rec-card">
          <div class="vm-exercise-rec-left">
            <div class="vm-exercise-rec-icon">
              {% render 'vigour-icons', name: 'play' %}
            </div>
            <div>
              <span class="vm-exercise-rec-title"></span>
              <span class="vm-exercise-rec-sub"></span>
            </div>
          </div>
          <a href="{{ block.settings.programs_link | default: '#vigour-programs' }}" class="vm-monogram-pill" style="color: var(--vm-green-deep); text-decoration: none;">
            {{ 'pain_map.exercise_video' | t }}
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

<script src="{{ 'pain-map.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "VM Pain Map",
  "target": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "subheading", "label": "Subheading"},
    {"type": "text", "id": "booking_link", "label": "Booking link"},
    {"type": "text", "id": "programs_link", "label": "Programs link"}
  ]
}
{% endschema %}
