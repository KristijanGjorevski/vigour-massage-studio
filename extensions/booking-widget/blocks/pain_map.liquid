{{ 'vigour-tokens.css' | asset_url | stylesheet_tag }}
{{ 'pain-map.css' | asset_url | stylesheet_tag }}

<section class="vm-block-wrapper vm-painmap-section" 
         id="vm-painmap" 
         data-block-id="{{ block.id }}">
  <div class="vm-container">
    
    <div class="vm-painmap-header">
      <div class="vm-eyebrow">
        {% render 'vigour-icons', name: 'spark' %}
        <span>{{ block.settings.eyebrow | default: 'ИНТЕРАКТИВЕН ДИЈАГНОСТИЧКИ ВОДИЧ' }}</span>
      </div>
      <h2 class="vm-heading-lg vm-painmap-title">
        {{ block.settings.heading | default: 'Каде чувствувате болка или напнатост?' }}
      </h2>
      <p class="vm-painmap-subtitle">
        {{ block.settings.subheading | default: 'Изберете ја зоната на телото каде чувствувате непријатност за да добиете стручна препорака за соодветен масажен третман и закрепнувачки вежби.' }}
      </p>
    </div>

    <div class="vm-painmap-pills-bar">
      <button type="button" class="vm-zone-pill-btn active" data-zone="neck">Врат и глава</button>
      <button type="button" class="vm-zone-pill-btn" data-zone="shoulders">Рамена и трапез</button>
      <button type="button" class="vm-zone-pill-btn" data-zone="upper_back">Горен грб</button>
      <button type="button" class="vm-zone-pill-btn" data-zone="lower_back">Долен грб</button>
      <button type="button" class="vm-zone-pill-btn" data-zone="hips">Колк и седало</button>
      <button type="button" class="vm-zone-pill-btn" data-zone="legs">Колена и нозе</button>
      <button type="button" class="vm-zone-pill-btn" data-zone="feet">Стапала</button>
    </div>

    <div class="vm-painmap-grid">
      
      <div class="vm-bodymap-container" data-svg-url="{{ 'body-map.svg' | asset_url }}">
        <div class="vm-bodymap-instructions">
          {% render 'vigour-icons', name: 'spark' %}
          <span>Кликнете на било која зона на телото за анализа</span>
        </div>
      </div>

      <div class="vm-zone-panel">
        
        <div class="vm-zone-panel-header">
          <div class="vm-zone-tag">
            {% render 'vigour-icons', name: 'shield' %}
            <span class="vm-zone-tag-text">Најчеста канцелариска тензија</span>
          </div>
          <h3 class="vm-zone-name">Врат и глава</h3>
        </div>

        <div class="vm-zone-causes">
          <strong>Зошто се јавува болката:</strong>
          <span class="vm-zone-causes-text">
            Долго седење пред монитор, неправилна положба на спиење, психолошки стрес и акумулирана напнатост во горниот трапез.
          </span>
        </div>

        <div class="vm-rec-card">
          <div class="vm-rec-card-eyebrow">
            {% render 'vigour-icons', name: 'spark' %}
            <span>Препорачан масажен третман</span>
          </div>
          <h4 class="vm-rec-card-title">Релакс или Терапевтска Масажа за Врат</h4>
          <p class="vm-rec-card-desc">
            Фокусирано ослободување на спазмите во цервикалниот дел, рамената и базата на черепот за моментално олеснување од главоболки и вкочанетост.
          </p>

          <div class="vm-rec-card-footer">
            <div class="vm-rec-price-wrap">
              <span class="vm-rec-price-badge vm-rec-price-text">800 - 1.000 ден.</span>
              <small class="vm-rec-duration-text">45 мин</small>
            </div>

            <a href="{{ block.settings.booking_link | default: '#najdo-booking-container' }}" 
               class="vm-btn-primary vm-rec-book-btn"
               data-service-name="Релакс масажа - Грб">
              <span>Резервирај за оваа зона</span>
              {% render 'vigour-icons', name: 'chevron-right' %}
            </a>
          </div>
        </div>

        <div class="vm-exercise-rec-card">
          <div class="vm-exercise-rec-left">
            <div class="vm-exercise-rec-icon">
              {% render 'vigour-icons', name: 'play' %}
            </div>
            <div>
              <span class="vm-exercise-rec-title">2-минутно истегнување на врат</span>
              <span class="vm-exercise-rec-sub">Вежби за мобилност и декомпресија на трапез</span>
            </div>
          </div>
          <a href="{{ block.settings.programs_link | default: '#vigour-programs' }}" class="vm-monogram-pill" style="color: var(--vm-green-deep); text-decoration: none;">
            Видео
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

<script src="{{ 'pain-map.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "VM Pain Map",
  "target": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "subheading", "label": "Subheading"},
    {"type": "text", "id": "booking_link", "label": "Booking link"},
    {"type": "text", "id": "programs_link", "label": "Programs link"}
  ]
}
{% endschema %}
