{{ 'vigour-tokens.css' | asset_url | stylesheet_tag }}
{{ 'vigour-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign instagram_link = block.settings.instagram_link | default: 'https://www.instagram.com/vigour.massagestudio/'
  assign phone = block.settings.phone | default: '+38975304171'
  assign current_year = 'now' | date: '%Y'
-%}

<footer class="vm-block-wrapper vm-footer-wrapper" id="vm-footer-{{ block.id }}">
  <div class="vm-footer-container">

    <div class="vm-footer-grid">

      <div class="vm-footer-brand-col">
        <a href="{{ routes.root_url }}" class="vm-footer-logo-link" aria-label="{{ 'header.logo_label' | t | escape }}">
          {%- render 'vigour-logo', on_dark: true -%}
        </a>
        <p class="vm-footer-tagline">
          {% render 'vigour-text', value: block.settings.tagline, key: 'footer.tagline' %}
        </p>
      </div>

      <div class="vm-footer-col">
        <h2 class="vm-footer-col-title">{{ 'footer.services_title' | t }}</h2>
        <ul class="vm-footer-links-list">
          <li><a href="#vigour-services">{{ 'footer.service_relax' | t }}</a></li>
          <li><a href="#vigour-services">{{ 'footer.service_sports' | t }}</a></li>
          <li><a href="#vigour-services">{{ 'footer.service_feet' | t }}</a></li>
          <li><a href="#vigour-services">{{ 'footer.service_premium' | t }}</a></li>
        </ul>
      </div>

      <div class="vm-footer-col">
        <h2 class="vm-footer-col-title">{{ 'footer.studio_title' | t }}</h2>
        <ul class="vm-footer-links-list">
          <li><a href="#vigour-programs">{{ 'footer.studio_programs' | t }}</a></li>
          <li><a href="#vm-packages">{{ 'footer.studio_packages' | t }}</a></li>
          <li><a href="#najdo-booking-container">{{ 'footer.studio_booking' | t }}</a></li>
          <li><a href="#vm-contact">{{ 'footer.studio_contact' | t }}</a></li>
        </ul>
      </div>

      <div class="vm-footer-col">
        <h2 class="vm-footer-col-title">{{ 'footer.contact_title' | t }}</h2>
        <ul class="vm-footer-links-list">
          <li><a href="tel:{{ phone }}">{{ block.settings.phone_display | default: '+389 75 304 171' }}</a></li>
          <li><a href="{{ instagram_link }}" target="_blank" rel="noopener">{{ block.settings.instagram_handle | default: '@vigour.massagestudio' }}</a></li>
          <li><span>{% render 'vigour-text', value: block.settings.city, key: 'footer.city' %}</span></li>
        </ul>
      </div>

    </div>

    <div class="vm-footer-bottom">
      <span>
        {%- if block.settings.copyright != blank -%}
          {{ block.settings.copyright }}
        {%- else -%}
          {{ 'footer.copyright' | t: year: current_year }}
        {%- endif -%}
      </span>
      <span>{{ 'footer.payment_note' | t }} · <a href="{{ instagram_link }}" target="_blank" rel="noopener">Instagram</a></span>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "VM Footer",
  "target": "section",
  "settings": [
    {"type": "textarea", "id": "tagline", "label": "Tagline"},
    {"type": "text", "id": "phone_display", "label": "Phone display"},
    {"type": "text", "id": "phone", "label": "Phone link", "info": "International format, e.g. +38975304171"},
    {"type": "text", "id": "instagram_handle", "label": "Instagram handle"},
    {"type": "text", "id": "instagram_link", "label": "Instagram link"},
    {"type": "text", "id": "city", "label": "City"},
    {"type": "text", "id": "copyright", "label": "Copyright text", "info": "Empty = © current year Vigour Massage Studio · Est. 2025"}
  ]
}
{% endschema %}
