{{ 'vigour-tokens.css' | asset_url | stylesheet_tag }}
{{ 'how-it-works.css' | asset_url | stylesheet_tag }}

<section class="vm-block-wrapper vm-process-section" 
         id="vm-how-it-works-{{ block.id }}" 
         data-block-id="{{ block.id }}">
  <div class="vm-container">
    
    <div class="vm-process-header">
      <div class="vm-eyebrow">
        {% render 'vigour-icons', name: 'spark' %}
        <span>{% render 'vigour-text', value: block.settings.eyebrow, key: 'how_it_works.eyebrow' %}</span>
      </div>
      <h2 class="vm-heading-lg vm-process-title">
        {% render 'vigour-text', value: block.settings.heading, key: 'how_it_works.heading' %}
      </h2>
      <p class="vm-process-subtitle">
        {% render 'vigour-text', value: block.settings.subheading, key: 'how_it_works.subheading' %}
      </p>
    </div>

    <div class="vm-process-grid">
      
      <div class="vm-step-card">
        <div class="vm-step-number-wrap">
          <span>01</span>
        </div>
        <h3 class="vm-step-title">
          {% render 'vigour-text', value: block.settings.step1_title, key: 'how_it_works.step1_title' %}
        </h3>
        <p class="vm-step-desc">
          {% render 'vigour-text', value: block.settings.step1_desc, key: 'how_it_works.step1_desc' %}
        </p>
        <div class="vm-step-icon-pill">
          {% render 'vigour-icons', name: 'spark' %}
          <span>{{ 'how_it_works.step1_pill' | t }}</span>
        </div>
      </div>

      <div class="vm-step-card">
        <div class="vm-step-number-wrap">
          <span>02</span>
        </div>
        <h3 class="vm-step-title">
          {% render 'vigour-text', value: block.settings.step2_title, key: 'how_it_works.step2_title' %}
        </h3>
        <p class="vm-step-desc">
          {% render 'vigour-text', value: block.settings.step2_desc, key: 'how_it_works.step2_desc' %}
        </p>
        <div class="vm-step-icon-pill">
          {% render 'vigour-icons', name: 'calendar' %}
          <span>{{ 'how_it_works.step2_pill' | t }}</span>
        </div>
      </div>

      <div class="vm-step-card">
        <div class="vm-step-number-wrap">
          <span>03</span>
        </div>
        <h3 class="vm-step-title">
          {% render 'vigour-text', value: block.settings.step3_title, key: 'how_it_works.step3_title' %}
        </h3>
        <p class="vm-step-desc">
          {% render 'vigour-text', value: block.settings.step3_desc, key: 'how_it_works.step3_desc' %}
        </p>
        <div class="vm-step-icon-pill">
          {% render 'vigour-icons', name: 'shield' %}
          <span>{{ 'how_it_works.step3_pill' | t }}</span>
        </div>
      </div>

    </div>

    {%- if block.settings.show_cta -%}
      <div class="vm-process-cta-wrap">
        <a href="{{ block.settings.cta_link | default: '#najdo-booking-container' }}" class="vm-btn-primary">
          {% render 'vigour-icons', name: 'calendar' %}
          <span>{% render 'vigour-text', value: block.settings.cta_text, key: 'how_it_works.cta' %}</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "VM How It Works",
  "target": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "subheading", "label": "Subheading"},
    {"type": "text", "id": "step1_title", "label": "Step 1 title"},
    {"type": "textarea", "id": "step1_desc", "label": "Step 1 description"},
    {"type": "text", "id": "step2_title", "label": "Step 2 title"},
    {"type": "textarea", "id": "step2_desc", "label": "Step 2 description"},
    {"type": "text", "id": "step3_title", "label": "Step 3 title"},
    {"type": "textarea", "id": "step3_desc", "label": "Step 3 description"},
    {"type": "checkbox", "id": "show_cta", "label": "Show CTA button", "default": true},
    {"type": "text", "id": "cta_text", "label": "CTA button text"},
    {"type": "text", "id": "cta_link", "label": "CTA link"}
  ]
}
{% endschema %}
