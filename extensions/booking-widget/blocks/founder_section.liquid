{{ 'vigour-tokens.css' | asset_url | stylesheet_tag }}
{{ 'founder-section.css' | asset_url | stylesheet_tag }}

<section class="vm-block-wrapper vm-founder-section" 
         id="vm-founder-{{ block.id }}" 
         data-block-id="{{ block.id }}">
  <div class="vm-container">
    <div class="vm-founder-grid">
      
      <div class="vm-founder-image-col">
        <div class="vm-founder-img-wrapper">
          {%- if block.settings.founder_image != blank -%}
            <img src="{{ block.settings.founder_image | image_url: width: 900 }}" 
                 alt="{{ block.settings.founder_name | default: 'Дарко - Vigour Massage Studio' }}" 
                 class="vm-founder-img" 
                 loading="lazy" />
          {%- else -%}
            <div class="vm-founder-placeholder">
              <div class="vm-monogram-pill" style="font-size: 1.5rem; padding: 8px 24px;">VM</div>
              <div style="font-family: var(--vm-font-heading); font-weight: 700; font-size: 1.2rem;">
                {{ block.settings.founder_name | default: 'Дарко' }}
              </div>
              <div style="font-size: 0.9rem; opacity: 0.85;">Основач & Сертифициран Терапевт</div>
            </div>
          {%- endif -%}
        </div>

        <div class="vm-founder-badge-float">
          <div class="vm-founder-badge-icon">
            {% render 'vigour-icons', name: 'shield' %}
          </div>
          <div>
            <div class="vm-founder-badge-title">Сертифициран Стручњак</div>
            <div class="vm-founder-badge-sub">Индивидуален третман за секој клиент</div>
          </div>
        </div>
      </div>

      <div class="vm-founder-content">
        <div class="vm-eyebrow">
          {% render 'vigour-icons', name: 'user' %}
          <span>{{ block.settings.eyebrow | default: 'ЗА ТЕРАПЕВТОТ' }}</span>
        </div>

        <h2 class="vm-heading-lg vm-founder-title">
          {{ block.settings.heading | default: 'Здраво, јас сум Дарко' }}
        </h2>

        <div class="vm-founder-role">
          {{ block.settings.role | default: 'Основач и Терапевт во Vigour Massage Studio' }}
        </div>

        <div class="vm-founder-bio">
          {{ block.settings.bio | default: 'Со долгогодишна посветеност на анатомијата на телото и терапевтските техники, мојата цел во Vigour е да ви помогнам да се ослободите од хроничните болки во грбот и вратот, да ја вратите лесната мобилност и да го ресетирате замореното тело.' }}
        </div>

        {%- if block.settings.quote != blank -%}
          <div class="vm-founder-quote">
            {{ block.settings.quote }}
          </div>
        {%- endif -%}

        <div class="vm-founder-pills">
          <div class="vm-founder-pill">
            {% render 'vigour-icons', name: 'check' %}
            <span>600+ завршени третмани</span>
          </div>
          <div class="vm-founder-pill">
            {% render 'vigour-icons', name: 'check' %}
            <span>Студио во Скопје (est. 2025)</span>
          </div>
          <div class="vm-founder-pill">
            {% render 'vigour-icons', name: 'check' %}
            <span>Индивидуален притисок</span>
          </div>
        </div>

        <div class="vm-founder-actions">
          <a href="{{ block.settings.booking_link | default: '#najdo-booking-container' }}" class="vm-btn-primary">
            {% render 'vigour-icons', name: 'calendar' %}
            <span>{{ block.settings.cta_text | default: 'Резервирај Термин' }}</span>
          </a>

          {%- if block.settings.instagram_url != blank -%}
            <a href="{{ block.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" class="vm-btn-instagram">
              {% render 'vigour-icons', name: 'instagram' %}
              <span>{{ block.settings.instagram_text | default: '@vigour.massagestudio' }}</span>
            </a>
          {%- endif -%}
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "VM About Founder",
  "target": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "text", "id": "role", "label": "Role / Position"},
    {"type": "textarea", "id": "bio", "label": "Bio description"},
    {"type": "textarea", "id": "quote", "label": "Quote / Philosophy"},
    {"type": "image_picker", "id": "founder_image", "label": "Founder Photo"},
    {"type": "text", "id": "founder_name", "label": "Founder name"},
    {"type": "text", "id": "cta_text", "label": "CTA button text"},
    {"type": "text", "id": "booking_link", "label": "Booking link"},
    {"type": "text", "id": "instagram_text", "label": "Instagram handle"},
    {"type": "text", "id": "instagram_url", "label": "Instagram URL"}
  ]
}
{% endschema %}
