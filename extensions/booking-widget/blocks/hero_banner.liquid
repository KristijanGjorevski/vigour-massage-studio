{{ 'vigour-tokens.css' | asset_url | stylesheet_tag }}
{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign book_url = block.settings.cta_primary_link | default: '#najdo-booking-container'
  assign map_url = block.settings.cta_secondary_link | default: '#vm-painmap'
  assign title_start = block.settings.heading_start | default: 'Помалку болка. Повеќе'
  assign title_accent = block.settings.heading_accent | default: 'енергија.'
  assign rating_line = block.settings.rating_text | default: '4,9 на Google'
-%}

<section class="vm-block-wrapper vm-hero" id="vm-hero-{{ block.id }}" data-api-base="/apps/vigour">
  <div class="vm-container vm-hero-grid">

    <div class="vm-hero-copy">
      <span class="vm-eyebrow">{{ block.settings.eyebrow | default: 'Масажа и рехабилитација · Скопје · од 2025' }}</span>
      <h1 class="vm-heading-xl vm-hero-title">{{ title_start }} <span class="vm-accent">{{ title_accent }}</span></h1>
      <p class="vm-lead-text vm-hero-lead">
        {{ block.settings.subheading | default: 'Релакс и спортска масажа во Скопје, плус програми за рехабилитација што ги продолжуваш дома. Закажи онлајн за една минута и плати со картичка или во готово.' }}
      </p>

      <div class="vm-hero-cta">
        <a href="{{ book_url }}" class="vm-btn-primary">{{ block.settings.cta_primary_text | default: 'Закажи термин онлајн' }}</a>
        <a href="{{ map_url }}" class="vm-btn-secondary">{{ block.settings.cta_secondary_text | default: 'Каде те боли?' }}</a>
      </div>

      <div class="vm-hero-meta">
        {%- if block.settings.show_rating_line -%}
          <span>
            <span class="vm-hero-stars" aria-hidden="true">
              {%- for i in (1..5) -%}{% render 'vigour-icons', name: 'star', class: 'vm-hero-star' %}{%- endfor -%}
            </span>
            {{ rating_line }}
          </span>
        {%- endif -%}
        <span>{{ block.settings.meta_payment | default: 'Плаќање онлајн или во готово' }}</span>
        <span>{{ block.settings.meta_confirmation | default: 'Потврда веднаш на Viber' }}</span>
      </div>
    </div>

    <div class="vm-hero-visual">
      <div class="vm-arch">
        {%- if block.settings.arch_image != blank -%}
          {{ block.settings.arch_image | image_url: width: 860 | image_tag: widths: '430, 645, 860', sizes: '(max-width: 900px) 360px, 430px', loading: 'eager', fetchpriority: 'high', alt: block.settings.arch_image.alt, class: 'vm-arch-img' }}
        {%- else -%}
          {% render 'vigour-spine' %}
          <span class="vm-arch-caption">{{ block.settings.arch_caption | default: 'Фото / видео од студиото' }}</span>
        {%- endif -%}
      </div>

      {%- if block.settings.show_next_slot_card -%}
        {%- comment -%} Filled from the booking calendar by hero-banner.js; stays hidden until it knows {%- endcomment -%}
        <a href="{{ book_url }}" class="vm-hero-card vm-hero-card--slot vm-hero-slot-card" hidden>
          <span class="vm-hero-card-icon vm-hero-card-icon--green"><span class="vm-hero-live-dot"></span></span>
          <span>
            <small>{{ block.settings.next_slot_label | default: 'Следен слободен термин' }}</small>
            <b class="vm-hero-slot-text"></b>
          </span>
        </a>
      {%- endif -%}

      {%- if block.settings.show_rating_card -%}
        <div class="vm-hero-card vm-hero-card--rating">
          <span class="vm-hero-card-icon vm-hero-card-icon--gold">{% render 'vigour-icons', name: 'star', class: 'vm-hero-card-star' %}</span>
          <span>
            <b>{{ block.settings.rating_score | default: '4,9 од 5' }}</b>
            <small>{{ block.settings.rating_label | default: '40+ рецензии на Google' }}</small>
          </span>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

<script src="{{ 'hero-banner.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "VM Hero Banner",
  "target": "section",
  "settings": [
    {"type": "header", "content": "Text"},
    {"type": "text", "id": "eyebrow", "label": "Small line above the heading"},
    {"type": "text", "id": "heading_start", "label": "Heading (plain part)"},
    {"type": "text", "id": "heading_accent", "label": "Heading (italic accent word)"},
    {"type": "textarea", "id": "subheading", "label": "Subheading"},
    {"type": "header", "content": "Buttons"},
    {"type": "text", "id": "cta_primary_text", "label": "Main button text"},
    {"type": "text", "id": "cta_primary_link", "label": "Main button link", "info": "Empty = the booking form"},
    {"type": "text", "id": "cta_secondary_text", "label": "Second button text"},
    {"type": "text", "id": "cta_secondary_link", "label": "Second button link", "info": "Empty = the pain map"},
    {"type": "header", "content": "Line under the buttons"},
    {"type": "checkbox", "id": "show_rating_line", "label": "Show stars and rating", "default": true},
    {"type": "text", "id": "rating_text", "label": "Rating text"},
    {"type": "text", "id": "meta_payment", "label": "Payment line"},
    {"type": "text", "id": "meta_confirmation", "label": "Confirmation line"},
    {"type": "header", "content": "Arch picture"},
    {"type": "image_picker", "id": "arch_image", "label": "Photo of the studio", "info": "Empty = the animated spine drawing"},
    {"type": "text", "id": "arch_caption", "label": "Caption (only without a photo)"},
    {"type": "header", "content": "Floating cards"},
    {"type": "checkbox", "id": "show_next_slot_card", "label": "Show next free slot card", "info": "Live from the booking calendar", "default": true},
    {"type": "text", "id": "next_slot_label", "label": "Next slot card title"},
    {"type": "checkbox", "id": "show_rating_card", "label": "Show Google rating card", "default": true},
    {"type": "text", "id": "rating_score", "label": "Rating card score"},
    {"type": "text", "id": "rating_label", "label": "Rating card text"}
  ]
}
{% endschema %}
