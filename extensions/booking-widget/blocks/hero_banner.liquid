{{ 'vigour-tokens.css' | asset_url | stylesheet_tag }}
{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

<section class="vm-block-wrapper vm-hero-section" 
         id="vm-hero-{{ block.id }}"
         data-block-id="{{ block.id }}"
         data-shop="{{ shop.permanent_domain }}"
         data-api-base="/apps/vigour">

  {%- if block.settings.background_image != blank -%}
    <div class="vm-hero-bg" 
         style="background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}'); opacity: {{ block.settings.bg_opacity | default: 18 | divided_by: 100.0 }};">
    </div>
  {%- else -%}
    <div class="vm-hero-bg" style="opacity: 0.15; background-image: radial-gradient(#2F5A51 1px, transparent 1px); background-size: 24px 24px;"></div>
  {%- endif -%}

  <div class="vm-hero-watermark"></div>

  <div class="vm-container vm-hero-container">
    <div class="vm-hero-grid">
      
      <div class="vm-hero-content">
        <div class="vm-hero-badge-wrap">
          <div class="vm-hero-badge">
            {% render 'vigour-icons', name: 'spark', class: 'vm-badge-icon' %}
            <span>{{ block.settings.eyebrow | default: 'VIGOUR MASSAGE STUDIO · СКОПЈЕ' }}</span>
          </div>

          {%- if block.settings.show_live_pill -%}
            <div class="vm-hero-live-pill">
              <span class="vm-live-dot"></span>
              <span>{{ block.settings.live_status_text | default: 'Отворено за резервации денес' }}</span>
            </div>
          {%- endif -%}
        </div>

        <h1 class="vm-heading-xl vm-hero-title">
          {{ block.settings.heading | default: 'Професионална масажа за обновување на твоето тело' }}
        </h1>

        <p class="vm-hero-subtitle">
          {{ block.settings.subheading | default: 'Ослободи се од болката во грбот, вратот и мускулите со стручни терапевтски и релакс техники прилагодени за твоите потреби.' }}
        </p>

        <div class="vm-hero-actions">
          <a href="{{ block.settings.cta_primary_link | default: '#najdo-booking-container' }}" class="vm-btn-primary">
            {% render 'vigour-icons', name: 'calendar' %}
            <span>{{ block.settings.cta_primary_text | default: 'Резервирај Сега' }}</span>
          </a>

          <a href="{{ block.settings.cta_secondary_link | default: '#vigour-services' }}" class="vm-btn-light">
            {% render 'vigour-icons', name: 'arrow-right' %}
            <span>{{ block.settings.cta_secondary_text | default: 'Погледни Услуги' }}</span>
          </a>
        </div>

        {%- if block.settings.show_stats -%}
          <div class="vm-hero-stats">
            <div class="vm-stat-item">
              <div class="vm-stat-num">{{ block.settings.stat1_num | default: '600+' }}</div>
              <div class="vm-stat-label">{{ block.settings.stat1_label | default: 'Задоволни клиенти' }}</div>
            </div>
            <div class="vm-stat-item">
              <div class="vm-stat-num">
                {{ block.settings.stat2_num | default: '4.9' }}<span>★</span>
              </div>
              <div class="vm-stat-label">{{ block.settings.stat2_label | default: 'Оценка на третманите' }}</div>
            </div>
            <div class="vm-stat-item">
              <div class="vm-stat-num">{{ block.settings.stat3_num | default: '100%' }}</div>
              <div class="vm-stat-label">{{ block.settings.stat3_label | default: 'Индивидуален пристап' }}</div>
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if block.settings.show_next_slot_card -%}
        <div class="vm-hero-slot-col">
          <div class="vm-hero-slot-card">
            <div class="vm-slot-card-header">
              <div class="vm-slot-tag">
                {% render 'vigour-icons', name: 'clock' %}
                <span>Следен слободен термин</span>
              </div>
              <div class="vm-monogram-pill" style="color: var(--vm-gold);">VM</div>
            </div>

            <div class="vm-slot-card-time">...</div>
            <div class="vm-slot-card-date">
              {% render 'vigour-icons', name: 'calendar' %}
              <span class="vm-slot-card-date-text">...</span>
            </div>

            <a href="{{ block.settings.cta_primary_link | default: '#najdo-booking-container' }}" class="vm-slot-btn">
              <span>{{ block.settings.next_slot_btn_text | default: 'Резервирај го овој термин' }}</span>
              {% render 'vigour-icons', name: 'chevron-right' %}
            </a>

            <div class="vm-slot-notice">
              🔒 Брза резервација без претплата • Плаќање во студио
            </div>
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

<script src="{{ 'hero-banner.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "VM Hero Banner",
  "target": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "subheading", "label": "Subheading"},
    {"type": "text", "id": "cta_primary_text", "label": "Primary CTA text"},
    {"type": "url", "id": "cta_primary_link", "label": "Primary CTA link"},
    {"type": "text", "id": "cta_secondary_text", "label": "Secondary CTA text"},
    {"type": "url", "id": "cta_secondary_link", "label": "Secondary CTA link"},
    {"type": "checkbox", "id": "show_next_slot_card", "label": "Show next slot card", "default": true},
    {"type": "text", "id": "next_slot_btn_text", "label": "Next slot button text"},
    {"type": "checkbox", "id": "show_live_pill", "label": "Show live status pill", "default": true},
    {"type": "text", "id": "live_status_text", "label": "Live status text"},
    {"type": "checkbox", "id": "show_stats", "label": "Show stats bar", "default": true},
    {"type": "text", "id": "stat1_num", "label": "Stat 1 number"},
    {"type": "text", "id": "stat1_label", "label": "Stat 1 label"},
    {"type": "text", "id": "stat2_num", "label": "Stat 2 number"},
    {"type": "text", "id": "stat2_label", "label": "Stat 2 label"},
    {"type": "text", "id": "stat3_num", "label": "Stat 3 number"},
    {"type": "text", "id": "stat3_label", "label": "Stat 3 label"},
    {"type": "image_picker", "id": "background_image", "label": "Background image"},
    {"type": "range", "id": "bg_opacity", "label": "Background opacity (%)", "min": 5, "max": 50, "step": 5, "default": 20}
  ]
}
{% endschema %}
