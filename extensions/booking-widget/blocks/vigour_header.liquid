{{ 'vigour-tokens.css' | asset_url | stylesheet_tag }}
{{ 'vigour-header.css' | asset_url | stylesheet_tag }}

<header class="vm-block-wrapper vm-header-wrapper" 
        id="vm-header-{{ block.id }}"
        data-shop="{{ shop.permanent_domain }}"
        data-country="{{ localization.country.iso_code | default: '' }}"
        data-locale="{{ request.locale.iso_code | default: '' }}"
        data-app-url="{{ block.settings.app_url | default: '' }}">
  <div class="vm-header-container">
    
    <a href="{{ routes.root_url | default: '/' }}" class="vm-header-logo-link" aria-label="Vigour Massage Studio Почетна">
      {% render 'vigour-logo', color: '#243F3A' %}
    </a>

    <nav class="vm-header-nav" aria-label="Главна навигација">
      <a href="{{ block.settings.link_home | default: '#' }}" class="vm-nav-item active">Почетна</a>
      <a href="{{ block.settings.link_services | default: '#vigour-services' }}" class="vm-nav-item">Услуги</a>
      <a href="{{ block.settings.link_programs | default: '#vigour-programs' }}" class="vm-nav-item">Програми</a>
      <a href="{{ block.settings.link_shop | default: '#vm-packages' }}" class="vm-nav-item">Продавница</a>
      <a href="{{ block.settings.link_contact | default: '#vm-contact' }}" class="vm-nav-item">Контакт</a>
    </nav>

    <div class="vm-header-actions">
      
      {%- if block.settings.show_availability -%}
        <div class="vm-header-availability">
          <span class="vm-status-dot pulse"></span>
          <span class="vm-availability-text">{{ block.settings.availability_text | default: 'Уште 2 слободни термини денес' }}</span>
        </div>
      {%- endif -%}

      {%- if block.settings.show_cart_icon -%}
        <a href="{{ routes.cart_url | default: '/cart' }}" class="vm-header-bag-btn" aria-label="Кошничка">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </a>
      {%- endif -%}

      <div class="vm-lang-switcher" aria-label="Јазик / Language">
        <button type="button" class="vm-lang-btn active" data-lang="mk">MK</button>
        <span class="vm-lang-divider">/</span>
        <button type="button" class="vm-lang-btn" data-lang="en">EN</button>
      </div>

      <a href="{{ block.settings.cta_link | default: '#najdo-booking-container' }}" class="vm-header-cta-btn">
        <span>{{ block.settings.cta_text | default: 'Закажи термин' }}</span>
      </a>

      <button type="button" class="vm-hamburger-btn" aria-label="Отвори мени" aria-expanded="false">
        <span class="vm-hamburger-line"></span>
        <span class="vm-hamburger-line"></span>
        <span class="vm-hamburger-line"></span>
      </button>

    </div>

  </div>

  <div class="vm-mobile-drawer" aria-label="Мобилно мени">
    <div class="vm-mobile-nav-list">
      <a href="{{ block.settings.link_home | default: '#' }}" class="vm-mobile-nav-item active">Почетна</a>
      <a href="{{ block.settings.link_services | default: '#vigour-services' }}" class="vm-mobile-nav-item">Услуги</a>
      <a href="{{ block.settings.link_programs | default: '#vigour-programs' }}" class="vm-mobile-nav-item">Програми</a>
      <a href="{{ block.settings.link_shop | default: '#vm-packages' }}" class="vm-mobile-nav-item">Продавница</a>
      <a href="{{ block.settings.link_contact | default: '#vm-contact' }}" class="vm-mobile-nav-item">Контакт</a>
    </div>

    <div class="vm-mobile-drawer-bottom">
      <div class="vm-lang-switcher" style="justify-content: center; width: 100%;">
        <button type="button" class="vm-lang-btn active" data-lang="mk">Македонски (MK)</button>
        <span class="vm-lang-divider">/</span>
        <button type="button" class="vm-lang-btn" data-lang="en">English (EN)</button>
      </div>

      <div class="vm-header-availability" style="display: inline-flex; width: 100%; justify-content: center;">
        <span class="vm-status-dot pulse"></span>
        <span class="vm-availability-text">{{ block.settings.availability_text | default: 'Уште 2 слободни термини денес' }}</span>
      </div>

      <a href="{{ block.settings.cta_link | default: '#najdo-booking-container' }}" class="vm-btn-primary" style="width: 100%;">
        <span>{{ block.settings.cta_text | default: 'Закажи термин' }}</span>
      </a>
    </div>
  </div>
</header>

<script src="{{ 'vigour-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "VM Header Nav",
  "target": "section",
  "settings": [
    {"type": "text", "id": "link_home", "label": "Home link"},
    {"type": "text", "id": "link_services", "label": "Services link"},
    {"type": "text", "id": "link_programs", "label": "Programs link"},
    {"type": "text", "id": "link_shop", "label": "Shop link"},
    {"type": "text", "id": "link_contact", "label": "Contact link"},
    {"type": "checkbox", "id": "show_availability", "label": "Show availability pill", "default": true},
    {"type": "text", "id": "availability_text", "label": "Availability text"},
    {"type": "text", "id": "cta_text", "label": "CTA button text"},
    {"type": "text", "id": "cta_link", "label": "CTA button link"},
    {"type": "checkbox", "id": "show_cart_icon", "label": "Show cart icon", "default": true},
    {"type": "text", "id": "app_url", "label": "Backend App URL"}
  ]
}
{% endschema %}
