{{ 'vigour-tokens.css' | asset_url | stylesheet_tag }}
{{ 'pricing-packages.css' | asset_url | stylesheet_tag }}

<section class="vm-block-wrapper vm-packages-section" 
         id="vm-packages-{{ block.id }}" 
         data-block-id="{{ block.id }}">
  <div class="vm-container">
    
    <div class="vm-packages-header">
      <div class="vm-eyebrow">
        {% render 'vigour-icons', name: 'spark' %}
        <span>{{ block.settings.eyebrow | default: 'ПАНОРАМА НА ЦЕНИ И ПАКЕТИ' }}</span>
      </div>
      <h2 class="vm-heading-lg vm-packages-title">
        {{ block.settings.heading | default: 'Пакети третмани & Подарок ваучери' }}
      </h2>
      <p class="vm-packages-subtitle">
        {{ block.settings.subheading | default: 'Инвестирајте во долгорочното здравје на вашето тело со заштеда, или подарете врвно релакс искуство на саканите.' }}
      </p>
    </div>

    <div class="vm-packages-grid">
      
      <div class="vm-package-card">
        <h3 class="vm-package-title">5× Спортска Масажа</h3>
        <p class="vm-package-desc">Идеален пакет за активни спортисти или луѓе со постојана канцелариска вкочанетост во грбот и рамената.</p>
        
        <div class="vm-package-price-wrap">
          <span class="vm-package-price">4.250 ден.</span>
          <span class="vm-package-savings">Заштеда 750 ден.</span>
        </div>

        <ul class="vm-package-features">
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>5 третмани по 45 минути</span>
          </li>
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>Фокус: грб, трапези, лопатки</span>
          </li>
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>Важност: 3 месеци од купување</span>
          </li>
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>Бесплатни совети за мобилност</span>
          </li>
        </ul>

        <a href="viber://chat?number=38975304171" class="vm-btn-primary">
          {% render 'vigour-icons', name: 'viber' %}
          <span>Нарачај на Viber</span>
        </a>
      </div>

      <div class="vm-package-card featured">
        <div class="vm-package-featured-badge">Најпопуларен избор</div>
        <h3 class="vm-package-title">10× Релакс Масажа</h3>
        <p class="vm-package-desc">Комплетна програма за регенерација на телото и умствена релаксација во текот на целата сезона.</p>
        
        <div class="vm-package-price-wrap">
          <span class="vm-package-price">12.000 ден.</span>
          <span class="vm-package-savings">Заштеда 1.000 ден.</span>
        </div>

        <ul class="vm-package-features">
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>10 третмани по 60 минути</span>
          </li>
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>Третман на целото тело</span>
          </li>
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>Важност: 6 месеци од купување</span>
          </li>
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>Приоритетен избор на термини</span>
          </li>
        </ul>

        <a href="viber://chat?number=38975304171" class="vm-btn-primary">
          {% render 'vigour-icons', name: 'viber' %}
          <span>Нарачај на Viber</span>
        </a>
      </div>

      <div class="vm-package-card">
        <h3 class="vm-package-title">Подарок Ваучер</h3>
        <p class="vm-package-desc">Елегантно спакуван физички или дигитален ваучер за роденден, годишнина или внимание кон блиските.</p>
        
        <div class="vm-package-price-wrap">
          <span class="vm-package-price">од 800 ден.</span>
          <span class="vm-package-savings">По избор</span>
        </div>

        <ul class="vm-package-features">
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>Ваучер 800 ден. (Релакс грб 45м)</span>
          </li>
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>Ваучер 1.300 ден. (Релакс тело 60м)</span>
          </li>
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>Ваучер 2.500 ден. (Премиум ритуал)</span>
          </li>
          <li class="vm-package-feature-item">
            {% render 'vigour-icons', name: 'check' %}
            <span>Елегантно печатено пакување</span>
          </li>
        </ul>

        <a href="viber://chat?number=38975304171" class="vm-btn-secondary">
          {% render 'vigour-icons', name: 'spark' %}
          <span>Побарај Ваучер</span>
        </a>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "VM Pricing",
  "target": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "subheading", "label": "Subheading"}
  ]
}
{% endschema %}
